        "label": "-"
      },
      "style": {
        "w": 64
      }
    },
    "music_value": {
      "type": "label",
      "name": "Label",
      "text": "Label",
      "property": "musicLabel",
      "style": {
        "fontSize": 22,
        "color": "#ffffffff",
        "w": 250,
        "h": 50,
        "textAlign": "center"
      }
