    "close_settings": {
      "type": "use",
      "doc": "fight-button",
      "key": "close-settings",
      "props": {
        "label": "DONE"
      },
      "style": {
        "w": 240
      }
    },
    "audio_note": {
      "type": "label",
      "name": "Label",
