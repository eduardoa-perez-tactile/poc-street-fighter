    "music_up": {
      "type": "use",
      "doc": "fight-button",
      "key": "music-up",
      "props": {
        "label": "+"
      },
      "style": {
        "w": 64
      }
    },
    "sfx_row": {
      "type": "element",
      "name": "Element",
      "children": [
        "sfx_down",
        "sfx_value",
        "sfx_up"
