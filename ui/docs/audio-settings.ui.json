    "sfx_down": {
      "type": "use",
      "doc": "fight-button",
      "key": "sfx-down",
      "props": {
        "label": "-"
      },
      "style": {
        "w": 64
      }
    },
    "sfx_value": {
      "type": "label",
      "name": "Label",
      "text": "Label",
      "property": "sfxLabel",
      "style": {
        "fontSize": 22,
        "color": "#ffffffff",
        "w": 250,
        "h": 50,
        "textAlign": "center"
