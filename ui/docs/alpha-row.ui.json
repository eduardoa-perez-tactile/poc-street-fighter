    "row_arrow": {
      "type": "label",
      "name": "Label",
      "text": ">",
      "style": {
        "fontSize": 24,
        "color": "#fff3b0ff",
        "shadowX": 2,
        "shadowY": 2,
        "shadowColor": "#100b2fff",
        "w": 22,
        "h": "100%",
        "textAlign": "center",
        "position": "anchored",
        "anchor": [
          0,
          0.5
        ],
        "pivot": [
          0,
          0.5
        ],
        "offset": [
          14,
          0
        ]
      },
      "show": "active"
    },
    "row_label": {
      "type": "label",
      "name": "Label",
      "text": "",
      "style": {
        "fontSize": 22,
        "color": "#fff3b0ff",
        "shadowX": 2,
        "shadowY": 2,
        "shadowColor": "#100b2fff",
        "w": 0,
        "grow": 1,
        "h": "100%",
        "fitMin": 15
      },
      "property": "label"
    },
    "row_value": {
      "type": "label",
      "name": "Label",
      "text": "",
      "style": {
        "fontSize": 18,
        "color": "#fff3b0ff",
        "shadowX": 2,
        "shadowY": 2,
        "shadowColor": "#100b2fff",
        "w": 210,
        "h": "100%",
        "fitMin": 14,
        "textAlign": "right"
      },
      "property": "value",
      "show": "valued"
    }
  },
  "transition": {
    "type": "instant"
  },
