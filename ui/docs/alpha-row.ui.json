    "active": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#f04b67ff"
            },
            "row_label": {
              "color": "#fff3b0ff"
            }
          }
        }
      }
    },
    "valued": {
      "type": "yesno",
      "default": false
    }
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "bg": "#d72b4fff"
        }
      }
