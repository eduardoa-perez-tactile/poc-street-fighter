{
  "$schemaVersion": 1,
  "guid": "99fea78d-fc0a-45b7-9346-f93933dbc968",
  "name": "alpha-row",
  "title": "Alpha row",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Alpha row",
      "style": {
        "dir": "row",
        "pad": [
          3,
          44,
          3,
          44
        ],
        "align": "center",
        "bg": "#00000000",
        "radius": 0,
        "gap": 12,
        "h": 40
