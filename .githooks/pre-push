#!/bin/sh
# Main is advanced by verified squash PRs on GitHub, never direct local pushes.
while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo 'Direct pushes to main are disabled. Use a feature branch and npm run pr:merge.' >&2
    exit 1
  fi
done
